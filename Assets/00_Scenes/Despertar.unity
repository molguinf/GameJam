    segundosAutomatico: 3
  - imagen: {fileID: 1591073587}
    texto: "Abuelita: \"\xBFVas a venir para Todos Santos, wawa?\"\n28 de octubre
      \xB7 Visto"
    sonido: {fileID: 0}
    esperarClic: 1
    segundosAutomatico: 3
  - imagen: {fileID: 214443842}
    texto: "\"Volviste, wawa\u2026\""
